# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon): pode ir para o navegador; o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret/service_role): SÓ no servidor. Nunca use NEXT_PUBLIC_ aqui.
SUPABASE_SECRET_KEY=

# Endereço público do app (usado nos links enviados por WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: aviso por e-mail ao Gui quando chegar uma nova solicitação (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
